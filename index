  <!-- ==================== 완벽 검증된 자바스크립트 전체 ==================== -->
  <script>
    let currentPopCard = 'lotte';
    let currentPopDataList = [];

    function triggerA4LandscapePrint() {
      window.print();
    }

    function setPopCardType(cType) {
      currentPopCard = cType;
      const bLotte = document.getElementById('pop-card-lotte');
      const bWoori = document.getElementById('pop-card-woori');
      if (cType === 'lotte') {
        bLotte.className = "px-3 py-1.5 bg-blue-600 text-white transition";
        bWoori.className = "px-3 py-1.5 text-stone-600 hover:bg-stone-100 transition";
      } else {
        bWoori.className = "px-3 py-1.5 bg-blue-600 text-white transition";
        bLotte.className = "px-3 py-1.5 text-stone-600 hover:bg-stone-100 transition";
      }
      if (currentPopDataList.length > 0) {
        renderPhotoStylePOPCards(currentPopDataList);
      }
    }

    function openPopModal() {
      const el = document.getElementById('pop-modal');
      if (el) {
        el.style.display = 'flex';
        el.style.setProperty('display', 'flex', 'important');
        el.classList.remove('hidden');
      }
      if (!currentPopDataList || currentPopDataList.length === 0) {
        loadSampleExcelData();
      }
    }

    function closePopModal() {
      const el = document.getElementById('pop-modal');
      if (el) {
        el.style.display = 'none';
        el.style.setProperty('display', 'none', 'important');
      }
    }

    // [핵심] 정기케어1, 2 & 올케어 혜택 탑재 A4 가로 2-UP 쇼카드 렌더링
    function renderPhotoStylePOPCards(items) {
      currentPopDataList = items;
      const emptyState = document.getElementById('pop-empty-state');
      if (emptyState) emptyState.style.display = 'none';

      const container = document.getElementById('pop-cards-container');
      if (!container) return;
      container.innerHTML = '';

      const cardName = currentPopCard === 'lotte' ? '롯데카드' : '우리카드';
      const benefitWord = currentPopCard === 'lotte' ? '캐시백' : '청구할인';

      // 2개씩 짝지어 A4 가로 1장 생성
      for (let i = 0; i < items.length; i += 2) {
        const item1 = items[i];
        const item2 = items[i + 1] || items[i];

        const pageHTML = `
          <div class="pop-page-pair">
            <!-- 좌측 쇼카드 (1) -->
            ${generateSinglePopCardHTML(item1, cardName, benefitWord)}

            <!-- 중앙 절취선 -->
            <div class="pop-divider">
              <span class="text-xs text-stone-400 no-print" style="margin-left:-8px;">✂</span>
            </div>

            <!-- 우측 쇼카드 (2) -->
            ${generateSinglePopCardHTML(item2, cardName, benefitWord)}
          </div>
        `;
        container.insertAdjacentHTML('beforeend', pageHTML);
      }
    }

    function generateSinglePopCardHTML(item, cardName, benefitWord) {
      const brand = item.brand || item['브랜드'] || '삼성';
      const category = item.category || item['품목'] || '4도어 냉장고';
      const model = item.model || item['상품코드'] || item['모델명'] || 'WPU-CMDLEK';
      
      const fee3Y = Number(item.fee3Y || item['3년구독료'] || item['36개월'] || 33000);
      const fee5Y = Number(item.fee5Y || item['5년구독료'] || item['60개월'] || 30000);
      
      // [요청반영 1] 제휴카드 혜택 18,000원 고정 세팅!
      const disc = 18000;
      const final3Y = Math.max(0, fee3Y - disc);
      const final5Y = Math.max(0, fee5Y - disc);

      const totalSum3Y = fee3Y * 36;
      const totalSum5Y = fee5Y * 60;

      // [요청반영 2] 엑셀에서 정기케어1, 정기케어2, 올케어 혜택 자동 매핑!
      const care1 = item.care1 || item['정기케어1'] || item['정기케어 1'] || '4개월 주기 필터 무료 배송';
      const care2 = item.care2 || item['정기케어2'] || item['정기케어 2'] || '1년 주기 전문가 방문 케어';
      const allCare = item.allCare || item['올케어혜택'] || item['올케어 혜택'] || item['올케어'] || '5년 무상 A/S 기본 보장 + 수리비 전액 지원';

      const imgUrl = item.imgUrl || "https://images.unsplash.com/photo-1571175443880-49e1d25b2bc5?auto=format&fit=crop&w=300&q=80";

      return `
        <div class="pop-card-single">
          
          <!-- 상단: 롯데 로고 + 브랜드/품목/모델코드 + 제품 이미지 -->
          <div>
            <div class="flex items-center justify-between border-b-2 border-stone-800 pb-1.5">
              <div class="flex items-center gap-1.5 font-bold text-sm">
                <span class="w-4 h-4 rounded-full bg-[#ED1C24] text-white flex items-center justify-center text-[10px] font-black italic">l</span>
                <span class="text-[#ED1C24] font-black">롯데하이마트</span>
                <span class="text-stone-400 font-normal">|</span>
                <span class="text-stone-900 font-extrabold">상록수점</span>
              </div>
            </div>

            <div class="flex items-start justify-between pt-2">
              <div>
                <div class="text-sm font-bold text-stone-800">${brand}</div>
                <h4 class="text-2xl sm:text-[26px] font-black text-stone-950 mt-0.5 tracking-tight leading-none">${category}</h4>
                <div class="text-xs font-semibold text-stone-500 mt-1 font-mono">${model}</div>
              </div>
              <div class="w-20 h-24 sm:w-22 sm:h-26 flex-shrink-0 bg-stone-50 rounded-xl border border-stone-200 overflow-hidden flex items-center justify-center p-1">
                <img src="${imgUrl}" alt="${category}" class="w-full h-full object-contain">
              </div>
            </div>

            <!-- [요청반영 2] 여백을 채우는 정기케어1, 2 및 올케어 상세 혜택 박스 -->
            <div class="mt-2.5 space-y-1.5">
              <!-- 정기케어 1 & 2 나란히 배치 -->
              <div class="grid grid-cols-2 gap-1.5 text-[11px] font-extrabold text-stone-800">
                <div class="py-1.5 px-2.5 bg-[#EAF2FC] text-[#245CA6] rounded-lg border border-blue-200/60 truncate flex items-center gap-1">
                  <span>🌿</span> <span>${care1}</span>
                </div>
                <div class="py-1.5 px-2.5 bg-[#EAF2FC] text-[#245CA6] rounded-lg border border-blue-200/60 truncate flex items-center gap-1">
                  <span>🔧</span> <span>${care2}</span>
                </div>
              </div>

              <!-- 올케어 혜택 특별 강조 바 -->
              <div class="py-1.5 px-3 bg-amber-50 text-amber-900 rounded-lg font-black text-[11.5px] border border-amber-300 flex items-center justify-between">
                <span class="flex items-center gap-1">🛡️ 올케어 혜택</span>
                <span class="text-amber-800 text-[11px] font-bold">${allCare}</span>
              </div>
            </div>
          </div>

          <!-- 조견표 (제휴카드 18,000원 혜택 고정 반영) -->
          <div class="my-2 border border-stone-300 rounded-xl overflow-hidden">
            <table class="w-full text-center text-xs border-collapse">
              <thead class="bg-[#ECECEC] text-stone-700 font-bold border-b border-stone-300">
                <tr>
                  <th class="py-2 px-3 text-left pl-3 text-stone-800 w-1/3 text-xs">구독 기간</th>
                  <th class="py-2 px-2 w-1/3 text-stone-950 font-black text-sm">3년</th>
                  <th class="py-2 px-2 w-1/3 text-stone-950 font-black text-sm">5년</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-stone-200 font-semibold text-stone-800">
                <tr>
                  <td class="py-2 px-3 text-left pl-3 bg-stone-50 text-stone-600 font-bold">기본 구독료</td>
                  <td class="py-2 px-2 text-sm font-bold">월 ${fee3Y.toLocaleString()}원</td>
                  <td class="py-2 px-2 text-sm font-bold">월 ${fee5Y.toLocaleString()}원</td>
                </tr>
                <tr class="bg-amber-50/40">
                  <td class="py-2 px-3 text-left pl-3 text-stone-900 font-black">제휴카드 시</td>
                  <td class="py-2 px-2">
                    <div class="font-black text-sm text-stone-950">월 ${final3Y.toLocaleString()}원</div>
                    <div class="text-[10px] text-stone-500 font-normal">(${cardName})</div>
                  </td>
                  <td class="py-2 px-2">
                    <div class="font-black text-sm text-stone-950">월 ${final5Y.toLocaleString()}원</div>
                    <div class="text-[10px] text-stone-500 font-normal">(${cardName})</div>
                  </td>
                </tr>
                <tr>
                  <td class="py-2 px-3 text-left pl-3 bg-stone-50 text-stone-600 font-bold">제휴카드 총 혜택 금액</td>
                  <td class="py-2 px-2 text-[#2263B8] font-black text-sm">월 18,000원</td>
                  <td class="py-2 px-2 text-[#2263B8] font-black text-sm">월 18,000원</td>
                </tr>
              </tbody>
            </table>
          </div>

          <!-- 하단 안내 문구 & 공식 롯데 로고 -->
          <div class="pt-1.5 border-t border-stone-200 space-y-1">
            <div class="text-[9.5px] text-stone-600 space-y-0.5 leading-tight">
              <p>※ 서비스 안내 : 36개월 기준</p>
              <p>※ 제휴카드 실적 30만원 이상 사용 기준 (${cardName} ${benefitWord})</p>
              <p>※ 총 구독료 : 3년 ${totalSum3Y.toLocaleString()}원 / 5년 ${totalSum5Y.toLocaleString()}원</p>
            </div>

            <div class="pt-0.5 flex items-center justify-center gap-1.5 text-[#ED1C24]">
              <span class="w-3.5 h-3.5 rounded-full bg-[#ED1C24] text-white flex items-center justify-center text-[9px] font-black italic">l</span>
              <span class="font-black text-xs tracking-wider">LOTTE HIMART</span>
            </div>
          </div>

        </div>
      `;
    }

    // 엑셀 파일 업로드 시 정기케어1, 2, 올케어 자동 파싱
    function handleExcelUpload(event) {
      const file = event.target.files[0];
      if (!file) return;

      const reader = new FileReader();
      reader.onload = function(e) {
        try {
          const data = new Uint8Array(e.target.result);
          const workbook = XLSX.read(data, { type: 'array' });
          const sheetName = workbook.SheetNames.includes('값정리') ? '값정리' : workbook.SheetNames[0];
          const worksheet = workbook.Sheets[sheetName];
          const rows = XLSX.utils.sheet_to_json(worksheet);

          if (!rows || rows.length === 0) {
            alert("엑셀 파일에 데이터가 없습니다.");
            return;
          }

          const parsedItems = rows.map(r => ({
            brand: r['브랜드'] || '삼성',
            category: r['품목'] || r['상품명'] || '4도어 냉장고',
            model: r['상품코드'] || r['모델명'] || 'WPU-CMDLEK',
            fee3Y: Number(r['3년구독료'] || r['36개월'] || r['월 구독료'] || 33000),
            fee5Y: Number(r['5년구독료'] || r['60개월'] || 30000),
            care1: r['정기케어1'] || r['정기케어 1'] || r['케어서비스1'] || '4개월 주기 필터 무료 배송',
            care2: r['정기케어2'] || r['정기케어 2'] || r['케어서비스2'] || '1년 주기 전문가 방문 케어',
            allCare: r['올케어혜택'] || r['올케어 혜택'] || r['올케어'] || r['안심케어'] || '5년 무상 A/S 기본 보장 + 수리비 전액 지원',
            imgUrl: r['이미지'] || "https://images.unsplash.com/photo-1571175443880-49e1d25b2bc5?auto=format&fit=crop&w=300&q=80"
          }));

          renderPhotoStylePOPCards(parsedItems);
          alert(`총 ${parsedItems.length}개 품목의 정기케어·올케어 반영 쇼카드가 생성되었습니다!`);

        } catch (err) {
          console.error("엑셀 파싱 에러:", err);
          alert("엑셀 파일을 읽는 중 오류가 발생했습니다. 양식을 확인해 주세요.");
        }
      };
      reader.readAsArrayBuffer(file);
    }

    // 신규 케어 혜택 포함 샘플 데이터
    function loadSampleExcelData() {
      const sampleItems = [
        {
          brand: "삼성",
          category: "4도어 냉장고",
          model: "WPU-CMDLEK",
          fee3Y: 33000,
          fee5Y: 30000,
          care1: "4개월 주기 정기 필터 무료 배송",
          care2: "1년 주기 전문가 방문 살균 클리닝",
          allCare: "5년 무상 A/S 보장 + 수리비 전액 지원",
          imgUrl: "https://images.unsplash.com/photo-1571175443880-49e1d25b2bc5?auto=format&fit=crop&w=300&q=80"
        },
        {
          brand: "LG전자",
          category: "오브제 워시타워",
          model: "WL21WVS",
          fee3Y: 45000,
          fee5Y: 39000,
          care1: "완전분해 스팀 통살균 케어",
          care2: "고무패킹 및 배수필터 무상 교체",
          allCare: "가전 올케어 5년 부품·출장 무상 보증 (자기부담금 0원)",
          imgUrl: "https://images.unsplash.com/photo-1626806787461-102c1bfaaea1?auto=format&fit=crop&w=300&q=80"
        }
      ];
      renderPhotoStylePOPCards(sampleItems);
    }

    // 모달 공통 열기/닫기
    function openModal(id) {
      if (id === 'pop-modal') {
        openPopModal();
        return;
      }
      const el = document.getElementById(id);
      if (!el) return;
      if (id === 'ai-drawer') el.classList.remove('translate-x-full');
      else { el.style.display = 'flex'; el.classList.remove('hidden'); }
    }

    function closeModal(id) {
      if (id === 'pop-modal') {
        closePopModal();
        return;
      }
      const el = document.getElementById(id);
      if (!el) return;
      if (id === 'ai-drawer') el.classList.add('translate-x-full');
      else el.style.display = 'none';
    }

    // 테마 설정
    function toggleDarkMode() {
      const isDark = document.body.classList.toggle('dark');
      const icon = document.getElementById('theme-icon');
      if (isDark) {
        icon.innerText = '🌙';
        localStorage.setItem('park_theme_mode', 'dark');
      } else {
        icon.innerText = '☀️';
        localStorage.setItem('park_theme_mode', 'light');
      }
    }

    function initTheme() {
      const savedTheme = localStorage.getItem('park_theme_mode');
      if (savedTheme === 'dark') {
        document.body.classList.add('dark');
        document.getElementById('theme-icon').innerText = '🌙';
      }
    }

    // 초기화
    window.addEventListener('DOMContentLoaded', () => {
      initTheme();
      loadSampleExcelData();
    });
  </script>
</body>
