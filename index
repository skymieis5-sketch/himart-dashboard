<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
  <title>상록수 하이마트 박인성 부점장 전용 대시보드</title>
  <!-- Tailwind CSS & SheetJS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      darkMode: 'class'
    }
  </script>
  <script src="https://cdn.jsdelivr.net/npm/xlsx@0.18.5/dist/xlsx.full.min.js"></script>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard/dist/web/static/pretendard.css">
  <style>
    body { font-family: 'Pretendard', -apple-system, BlinkMacSystemFont, system-ui, Roboto, sans-serif; background-color: #F4F3EE; color: #1A1A1A; transition: background-color 0.3s, color 0.3s; }
    body.dark { background-color: #121212; color: #E5E7EB; }
    body.dark .bg-white { background-color: #1E1E1E !important; color: #E5E7EB !important; border-color: #333333 !important; }
    body.dark .bg-stone-50, body.dark .bg-stone-50\/70, body.dark .bg-stone-100 { background-color: #272727 !important; color: #E5E7EB !important; border-color: #383838 !important; }
    body.dark .text-stone-900, body.dark .text-stone-800, body.dark .text-stone-700 { color: #F3F4F6 !important; }
    body.dark .text-stone-600, body.dark .text-stone-500 { color: #9CA3AF !important; }
    body.dark .border-stone-200, body.dark .border-stone-300 { border-color: #374151 !important; }
    
    .scrollbar-none::-webkit-scrollbar { display: none; }
    .scrollbar-none { -ms-overflow-style: none; scrollbar-width: none; }

    /* ================= A4 가로 2-UP 완벽 인쇄 전용 CSS ================= */
    @media print {
      @page {
        size: A4 landscape !important;
        margin: 0 !important;
      }
      html, body {
        width: 297mm !important;
        height: 210mm !important;
        margin: 0 !important;
        padding: 0 !important;
        background: white !important;
        -webkit-print-color-adjust: exact !important;
        print-color-adjust: exact !important;
      }
      body * {
        visibility: hidden !important;
      }
      #pop-print-area, #pop-print-area * {
        visibility: visible !important;
      }
      #pop-print-area {
        position: absolute !important;
        left: 0 !important;
        top: 0 !important;
        width: 297mm !important;
        margin: 0 !important;
        padding: 0 !important;
        display: block !important;
        background: white !important;
      }
      .pop-page-pair {
        width: 297mm !important;
        height: 210mm !important;
        box-sizing: border-box !important;
        padding: 7mm 9mm !important;
        display: grid !important;
        grid-template-columns: 1fr 16px 1fr !important;
        page-break-after: always !important;
        break-after: page !important;
        background: white !important;
        overflow: hidden !important;
      }
      .pop-card-single {
        width: 100% !important;
        height: 196mm !important;
        box-sizing: border-box !important;
        border: 2px solid #222 !important;
        border-radius: 14px !important;
        padding: 8mm 9mm 7mm 9mm !important;
        display: flex !important;
        flex-direction: column !important;
        justify-content: space-between !important;
        background: white !important;
      }
      .pop-divider {
        display: flex !important;
        flex-direction: column !important;
        align-items: center !important;
        justify-content: center !important;
        border-left: 2px dashed #999 !important;
        height: 100% !important;
      }
      .no-print { display: none !important; }
    }
  </style>
</head>
<body class="p-2.5 sm:p-4 md:p-8 min-h-screen">

  <div class="max-w-4xl mx-auto space-y-3.5 sm:space-y-4">

    <!-- 1. HEADER NAV -->
    <header class="flex items-center justify-between bg-transparent py-1 sm:py-2 gap-1.5 flex-wrap">
      <div class="flex items-center gap-1.5 flex-wrap">
        <button onclick="window.scrollTo({top: 0, behavior: 'smooth'})" class="flex items-center gap-1 px-3 py-1.5 bg-white border border-stone-300 rounded-full text-xs font-semibold shadow-sm hover:bg-stone-50 active:scale-95 transition">
          <span>🏠</span> 홈
        </button>
        <button onclick="openModal('schedule-modal')" class="flex items-center gap-1 px-3 py-1.5 bg-white border border-stone-300 rounded-full text-xs font-bold text-amber-900 shadow-sm hover:bg-amber-50 active:scale-95 transition">
          <span>📅</span> 매장 휴무표
        </button>
        <button onclick="openModal('ai-drawer')" class="flex items-center gap-1 px-3.5 py-1.5 bg-gradient-to-r from-purple-600 to-indigo-600 text-white rounded-full text-xs font-bold shadow-md hover:opacity-90 transition active:scale-95 animate-pulse">
          <span>✦</span> AI 비서
        </button>
      </div>

      <div class="flex items-center gap-1.5">
        <button id="theme-toggle-btn" onclick="toggleDarkMode()" title="화면 모드 전환" class="w-8 h-8 rounded-full bg-white border border-stone-300 flex items-center justify-center text-xs shadow-sm hover:bg-stone-100 active:scale-95 transition">
          <span id="theme-icon">☀️</span>
        </button>
        <button onclick="openModal('all-menu-modal')" class="flex items-center gap-1 px-3 py-1.5 bg-white border border-stone-300 hover:border-stone-400 rounded-full text-xs font-semibold shadow-sm active:scale-95 transition">
          <span>☰</span> 전체메뉴
        </button>
      </div>
    </header>

    <!-- 2. TOP STATUS: 박인성 부점장님 맞춤 현황판 -->
    <div class="bg-white rounded-2xl sm:rounded-3xl p-4 sm:p-5 border border-stone-200/80 shadow-sm space-y-3 sm:space-y-4">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-3 sm:gap-4">
        
        <!-- 실시간 휴무 알림 카드 -->
        <div class="flex items-center gap-3 sm:gap-4 bg-stone-50/70 p-3.5 sm:p-4 rounded-xl sm:rounded-2xl border border-stone-200/60">
          <div class="w-12 h-12 sm:w-14 sm:h-14 rounded-full border-4 border-amber-400 flex flex-col items-center justify-center bg-white shadow-sm flex-shrink-0">
            <span class="text-[8px] sm:text-[9px] font-bold text-amber-600 -mb-0.5 sm:-mb-1">NEXT OFF</span>
            <span id="dynamic-next-dday" class="text-xs sm:text-sm font-extrabold text-stone-800">D-1</span>
          </div>
          <div>
            <div class="text-[10px] sm:text-[11px] text-amber-800 font-bold flex items-center gap-1">
              <span>상록수 하이마트 박인성 부점장</span>
              <span class="px-1.5 py-0.2 rounded bg-amber-100 text-amber-900 text-[9px]" id="today-fulldate-badge">날짜 동기화 중</span>
            </div>
            <div id="dynamic-off-notice" class="text-sm sm:text-base font-bold text-stone-900 mt-0.5">휴무 일정을 조회 중입니다...</div>
            <div class="text-[11px] sm:text-xs text-stone-500 mt-0.5">
              <span id="dynamic-vacation-notice">🔥 휴무 계획 확인 중</span> · <button onclick="openModal('schedule-modal')" class="text-purple-600 font-bold underline">전체 휴무표 보기 ›</button>
            </div>
          </div>
        </div>

        <!-- 실시간 근무 달성 게이지 -->
        <div class="bg-amber-50/50 p-3.5 sm:p-4 rounded-xl sm:rounded-2xl border border-amber-100 flex items-center gap-2.5 sm:gap-3">
          <div id="dynamic-status-emoji" class="text-2xl sm:text-3xl">🤩</div>
          <div class="flex-1">
            <div class="flex justify-between items-center">
              <span id="dynamic-work-badge" class="text-[11px] sm:text-xs font-bold text-amber-800 bg-amber-100 px-2 py-0.5 rounded-full">
                시간 계산 중...
              </span>
              <span class="text-[10px] sm:text-[11px] font-bold text-stone-500">잔여: <strong class="text-purple-600">5.25개</strong></span>
            </div>
            <div id="dynamic-work-text" class="text-[11px] sm:text-xs font-bold text-stone-800 mt-1">오늘 근무 스케줄 파악 중...</div>
            <div class="w-full bg-stone-200 h-2 rounded-full mt-1.5 overflow-hidden">
              <div id="dynamic-work-gauge" class="bg-emerald-500 h-full rounded-full transition-all duration-700" style="width: 0%;"></div>
            </div>
            <div class="text-[9px] sm:text-[10px] text-stone-500 mt-1 flex justify-between">
              <span id="dynamic-work-sub1">영업시간 10:00~20:30</span>
              <span id="dynamic-work-sub2" class="font-bold text-emerald-600">스케줄 동기화</span>
            </div>
          </div>
        </div>
      </div>

      <!-- 수당칸과 실적칸 (분리 카드) -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-3 pt-1">
        
        <!-- [카드 A] 수당 정산 관리 -->
        <div class="border border-amber-300/80 rounded-2xl p-3.5 sm:p-4 bg-gradient-to-br from-amber-50/50 to-amber-100/30 flex flex-col justify-between space-y-2.5 sm:space-y-3 shadow-sm">
          <div class="flex items-center justify-between">
            <span class="bg-amber-200/80 text-amber-950 text-xs px-2.5 py-1 rounded-full font-extrabold flex items-center gap-1.5">
              🪙 <span class="current-month-label">11월</span> 수당 정산
            </span>
            <button onclick="openHistoryModal()" class="text-[11px] bg-white hover:bg-rose-50 text-stone-600 hover:text-rose-600 px-2.5 py-1 rounded-full border border-stone-200 hover:border-rose-300 font-extrabold transition flex items-center gap-1 shadow-sm active:scale-95">
              <span>✏️</span> 내역/취소
            </button>
          </div>

          <div class="flex items-baseline justify-between pt-0.5">
            <span class="text-xs font-bold text-stone-600">당월 총 적립 수당</span>
            <span id="total-commission" class="text-xl sm:text-2xl font-black text-amber-800 tracking-tight">+0원</span>
          </div>

          <div class="pt-2 border-t border-amber-200/60 flex items-center justify-between">
            <span class="text-xs text-amber-900 font-bold">14대 브랜드 모델수당</span>
            <button type="button" onclick="openModal('incentive-modal')" class="px-2.5 py-1 bg-white hover:bg-amber-100 text-amber-900 border border-amber-300 rounded-lg text-xs font-extrabold transition flex items-center gap-1 shadow-sm active:scale-95">
              🏷️ <span id="model-count">0대</span> (<span id="model-comm" class="text-amber-700 font-black">+0원</span>) <span>›</span>
            </button>
          </div>
        </div>

        <!-- [카드 B] 영업 실적 관리 -->
        <div class="border border-stone-200 rounded-2xl p-3.5 sm:p-4 bg-stone-50/70 flex flex-col justify-between space-y-2.5 sm:space-y-3 shadow-sm">
          <div class="flex items-center justify-between">
            <span class="bg-stone-200 text-stone-800 text-xs px-2.5 py-1 rounded-full font-extrabold flex items-center gap-1.5">
              📈 <span class="current-month-label">11월</span> 영업 실적
            </span>
            <button onclick="openPerformanceModal('all')" class="text-[11px] bg-white hover:bg-stone-100 text-stone-700 px-2.5 py-1 rounded-full border border-stone-300 font-extrabold transition shadow-sm active:scale-95">
              ✏️ 실적 수정
            </button>
          </div>

          <div class="grid grid-cols-3 gap-1.5 text-center text-xs">
            <button type="button" onclick="openPerformanceModal('sub')" class="p-2 bg-white rounded-xl border border-red-200 hover:border-red-400 transition shadow-sm group">
              <div class="text-[10px] font-bold text-red-600">📦 구독</div>
              <div class="font-black text-sm text-stone-900 mt-0.5 group-hover:text-red-600"><span id="disp-sub">0</span>개 ›</div>
            </button>
            <button type="button" onclick="openPerformanceModal('care')" class="p-2 bg-white rounded-xl border border-blue-200 hover:border-blue-400 transition shadow-sm group">
              <div class="text-[10px] font-bold text-blue-600">🛡️ 올케어</div>
              <div class="font-black text-sm text-stone-900 mt-0.5 group-hover:text-blue-600"><span id="disp-care">0</span>개 ›</div>
            </button>
            <button type="button" onclick="openPerformanceModal('freed')" class="p-2 bg-white rounded-xl border border-sky-200 hover:border-sky-400 transition shadow-sm group">
              <div class="text-[10px] font-bold text-sky-600">💎 프리드</div>
              <div class="font-black text-sm text-stone-900 mt-0.5 group-hover:text-sky-600"><span id="disp-freed">0</span>건 ›</div>
            </button>
          </div>

          <div class="pt-2 border-t border-stone-200 flex items-center justify-between">
            <span class="text-xs text-stone-500 font-bold">당월 누적 매출</span>
            <button type="button" onclick="openPerformanceModal('sales')" class="px-2 py-1 bg-white hover:bg-purple-50 text-stone-800 border border-stone-300 hover:border-purple-300 rounded-lg text-xs font-extrabold transition flex items-center gap-1 shadow-sm active:scale-95">
              총판 <span id="disp-total-sales" class="text-blue-700 font-black">329만</span> · 실판 <span id="disp-real-sales" class="text-purple-700 font-black">1,763만</span> <span>›</span>
            </button>
          </div>
        </div>

      </div>

      <!-- 주간 7일 스케줄 -->
      <div>
        <div class="text-[10px] sm:text-[11px] font-bold text-stone-400 mb-1 flex justify-between">
          <span>📅 오늘 기준 실시간 주간 근무 캘린더</span>
          <span class="text-purple-600 font-bold">*보라색 링: 오늘(TODAY)</span>
        </div>
        <div class="overflow-x-auto scrollbar-none pb-0.5">
          <div id="dynamic-weekly-calendar" class="grid grid-cols-7 gap-1 text-center text-xs min-w-[340px]"></div>
        </div>
      </div>
    </div>

    <!-- 3. TODAY BRIEFING -->
    <div class="bg-stone-950 text-white rounded-2xl sm:rounded-3xl p-4 sm:p-5 shadow-sm space-y-3">
      <div class="flex items-center justify-between gap-2">
        <div>
          <div class="text-[11px] sm:text-xs font-bold tracking-wider text-sky-400">
            TODAY BRIEFING · 관리 고객 8명
          </div>
          <div class="text-sm sm:text-base font-bold mt-0.5">
            긴급 <span id="briefing-urgent-count" class="text-red-400 font-extrabold">3건</span> · 
            물류 <span id="briefing-logistics-count" class="text-amber-400 font-extrabold">0건</span> · 
            사은품 <span id="briefing-gift-count" class="text-sky-400 font-extrabold">1건</span>
          </div>
        </div>
        <button onclick="openVipBriefingModal()" class="bg-[#9E1B42] hover:bg-[#831636] text-white text-xs font-extrabold px-3 py-2 rounded-xl flex items-center gap-1 transition shadow-sm active:scale-95 flex-shrink-0">
          VIP 관리 →
        </button>
      </div>

      <div class="pt-2.5 border-t border-stone-800/90 space-y-2">
        <div id="briefing-items-container" class="space-y-1.5 max-h-44 overflow-y-auto pr-1"></div>

        <div class="flex gap-1.5 pt-1">
          <select id="quick-todo-category" class="bg-stone-900 border border-stone-800 text-[11px] px-2 py-1.5 rounded-xl font-bold text-stone-300 focus:outline-none">
            <option value="urgent">긴급</option>
            <option value="logistics">물류</option>
            <option value="gift">사은품</option>
          </select>
          <input type="text" id="quick-todo-input" placeholder="+ 새 할 일 추가 후 Enter" 
                 class="flex-1 bg-stone-900 border border-stone-800 text-xs px-2.5 py-1.5 rounded-xl text-stone-100 placeholder-stone-500 focus:outline-none focus:border-purple-500 min-w-0"
                 onkeypress="if(event.key === 'Enter') addQuickTodo()">
          <button onclick="addQuickTodo()" class="bg-purple-600 hover:bg-purple-700 text-white font-bold px-3 py-1.5 rounded-xl text-xs whitespace-nowrap transition shadow-sm">
            등록
          </button>
        </div>
      </div>
    </div>

    <!-- 4. STEP 01: 맞춤 견적 & 카드 혜택 설계 -->
    <div class="bg-white rounded-2xl sm:rounded-3xl p-4 sm:p-5 border border-stone-200/80 shadow-sm space-y-3">
      <div class="flex items-center justify-between">
        <h3 class="text-xs sm:text-sm font-extrabold text-stone-800 flex items-center gap-1.5">
          <span class="w-2 h-2 rounded-full bg-purple-600"></span> STEP 01 · 맞춤 견적 & 카드 혜택 설계
        </h3>
        <span class="text-[11px] text-purple-600 font-semibold bg-purple-50 px-2 py-0.5 rounded-full">AI 사진스캔</span>
      </div>

      <div class="grid grid-cols-2 sm:grid-cols-4 gap-2">
        <button type="button" onclick="openQuoteModal('regular')" class="p-3 sm:p-4 rounded-xl sm:rounded-2xl bg-stone-900 text-white text-left hover:bg-stone-800 transition active:scale-95 shadow-sm">
          <div class="font-bold text-xs sm:text-sm">일반 견적</div>
          <div class="text-[10px] sm:text-[11px] text-stone-400 mt-0.5">즉시할인+프리드</div>
        </button>

        <button type="button" onclick="openSubConfigModal()" class="p-3 sm:p-4 rounded-xl sm:rounded-2xl bg-stone-900 text-white text-left hover:bg-stone-800 transition active:scale-95 shadow-sm border border-sky-400/50 relative overflow-hidden">
          <span class="absolute top-1 right-2 text-[8px] sm:text-[9px] bg-sky-500 text-white px-1 py-0.5 rounded-full font-bold">인기</span>
          <div class="font-bold text-xs sm:text-sm text-sky-300">구독 견적</div>
          <div class="text-[10px] sm:text-[11px] text-sky-400 mt-0.5">36/60개월 설계 ›</div>
        </button>

        <button type="button" onclick="openQuoteModal('hybrid')" class="p-3 sm:p-4 rounded-xl sm:rounded-2xl bg-stone-900 text-white text-left hover:bg-stone-800 transition active:scale-95 shadow-sm">
          <div class="font-bold text-xs sm:text-sm">혼합 견적</div>
          <div class="text-[10px] sm:text-[11px] text-stone-400 mt-0.5">일반+구독 통합</div>
        </button>

        <button type="button" onclick="openQuoteModal('plan')" class="p-3 sm:p-4 rounded-xl sm:rounded-2xl bg-stone-50 border border-stone-200 text-left hover:bg-stone-100 transition active:scale-95 shadow-sm">
          <div class="font-bold text-xs sm:text-sm text-stone-900">플랜 계산기</div>
          <div class="text-[10px] sm:text-[11px] text-stone-500 mt-0.5">최대 -108만 할인</div>
        </button>
      </div>
    </div>

    <!-- 5. STEP 02: 매장 POP 자동 출력 단독 카드 -->
    <div class="bg-white rounded-2xl sm:rounded-3xl p-4 sm:p-5 border border-stone-200/80 shadow-sm space-y-3">
      <div class="flex items-center justify-between">
        <h3 class="text-xs sm:text-sm font-extrabold text-stone-800 flex items-center gap-1.5">
          <span class="w-2 h-2 rounded-full bg-amber-500"></span> STEP 02 · 매장 POP 자동 출력 (A4 가로 2-UP)
        </h3>
        <span class="text-[11px] text-stone-500">📄 엑셀 업로드 시 A5 2장 쇼카드 생성</span>
      </div>

      <button type="button" onclick="openPopModal()" class="w-full text-left p-4 sm:p-5 rounded-xl sm:rounded-2xl border border-stone-300 hover:border-purple-600 bg-stone-50/70 hover:bg-purple-50/20 transition active:scale-98 shadow-sm flex items-center justify-between gap-2">
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 sm:w-12 sm:h-12 rounded-xl bg-purple-100 text-purple-700 flex items-center justify-center text-xl sm:text-2xl flex-shrink-0">
            📊
          </div>
          <div>
            <div class="font-extrabold text-xs sm:text-sm text-stone-900 flex items-center gap-1.5 flex-wrap">
              <span>구독 POP 자동 출력기</span>
              <span class="text-[10px] bg-purple-600 text-white font-bold px-2 py-0.5 rounded-full">상록수점 쇼카드</span>
            </div>
            <div class="text-[11px] sm:text-xs text-stone-500 mt-0.5">
              정기케어 1, 2 및 올케어 혜택이 포함된 <strong>A4 가로 2-UP 정밀 쇼카드</strong>로 자동 인쇄됩니다.
            </div>
          </div>
        </div>
        <div class="px-3 py-1.5 bg-purple-600 hover:bg-purple-700 text-white rounded-xl text-xs font-bold whitespace-nowrap shadow-sm flex-shrink-0">
          출력기 열기 →
        </div>
      </button>
    </div>

  </div>

  <!-- ==================== [POP 모달] 정기케어1·2 & 올케어 혜택 탑재 A4 가로 2-UP ==================== -->
  <div id="pop-modal" style="display: none;" class="fixed inset-0 bg-black/60 z-[9999] items-center justify-center p-2 sm:p-4">
    <div class="bg-white rounded-2xl sm:rounded-3xl max-w-5xl w-full p-4 sm:p-6 shadow-2xl space-y-3.5 max-h-[96vh] overflow-y-auto flex flex-col">
      
      <!-- 상단 컨트롤러 -->
      <div class="flex justify-between items-center border-b pb-2.5 no-print flex-shrink-0">
        <div>
          <h3 class="font-extrabold text-sm sm:text-base text-stone-900 flex items-center gap-1.5">
            <span>📊</span> 상록수점 구독 POP 자동 출력기 (A4 가로 2-UP)
          </h3>
